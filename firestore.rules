rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Admins & Role Permissions collection (/admins/{adminId})
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update: if isValidId(adminId) &&
        incoming().role in ['super_admin', 'finance_manager', 'event_manager', 'gallery_moderator', 'notification_manager', 'admin', 'moderator'];
      allow delete: if isValidId(adminId);
    }

    // 1c. Student Moderator Requests collection (/moderator_requests/{requestId})
    match /moderator_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId) &&
        incoming().status in ['pending', 'accepted', 'rejected'] &&
        incoming().userName is string && incoming().userName.size() >= 2 && incoming().userName.size() <= 100;
      allow update: if isValidId(requestId) &&
        incoming().status in ['pending', 'accepted', 'rejected'];
      allow delete: if isValidId(requestId);
    }

    // 1b. Logged-in User Accounts collection (/user_accounts/{userId})
    match /user_accounts/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) &&
        incoming().displayName is string;
      allow delete: if isValidId(userId);
    }

    // 2. Scrub Party Students Collection (/scrub_students/{studentId})
    match /scrub_students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId) &&
        incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 120 &&
        incoming().totalFeeIQD is number && incoming().totalFeeIQD >= 0 &&
        incoming().verifiedPaidIQD is number && incoming().verifiedPaidIQD >= 0 &&
        incoming().remainingBalanceIQD is number && incoming().remainingBalanceIQD >= 0;
      allow delete: if isValidId(studentId);
    }

    // 3. Scrub Party Student Payments (/student_payments/{paymentId})
    match /student_payments/{paymentId} {
      allow get, list: if true;
      allow create, update: if isValidId(paymentId) &&
        incoming().studentId is string && incoming().studentId.size() > 0 &&
        incoming().amountIQD is number && incoming().amountIQD >= 0 && incoming().amountIQD <= 500000;
      allow delete: if isValidId(paymentId);
    }

    // 4. Immutable Administrative & Financial Audit Logs (/audit_logs/{logId})
    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) &&
        incoming().action is string && incoming().action.size() > 0;
      allow update, delete: if false;
    }

    // 5. Student Registration Requests (/registration_requests/{requestId})
    match /registration_requests/{requestId} {
      allow get, list: if true;
      allow create, update: if isValidId(requestId) &&
        incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 100;
      allow delete: if isValidId(requestId);
    }

    // 6. Approved Graduates collection (/graduates/{graduateId})
    match /graduates/{graduateId} {
      allow get, list: if true;
      allow create, update: if isValidId(graduateId) &&
        incoming().fullName is string;
      allow delete: if isValidId(graduateId);
    }

    // 7. General Payment Transactions & Ledgers (/payments/{paymentId})
    match /payments/{paymentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(paymentId);
    }

    // 8. Private Media Locker (/private_media/{mediaId})
    match /private_media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(mediaId);
    }

    // 9. Platform & Countdown Configuration Settings (/settings/{docId})
    match /settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId);
    }

    // 10. Smart Graduation Music Library Metadata (/graduation_songs/{songId})
    match /graduation_songs/{songId} {
      allow get, list: if true;
      allow create, update: if isValidId(songId) &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 200 &&
        incoming().artist is string && incoming().artist.size() >= 1 && incoming().artist.size() <= 150 &&
        incoming().category in ['graduation', 'party', 'calm', 'energetic', 'nasheed'] &&
        incoming().audioUrl is string && incoming().audioUrl.size() >= 1 && incoming().audioUrl.size() <= 2000;
      allow delete: if isValidId(songId);

      // Subcollection for chunked audio storage
      match /audio_chunks/{chunkId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(chunkId);
      }
    }

    // 11. Unified Notifications Collection (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if isValidId(notificationId) &&
        incoming().title is string && incoming().message is string;
      allow delete: if isValidId(notificationId);
    }

    // 12. Student Financial Record Link Requests (/financial_link_requests/{requestId})
    match /financial_link_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId) &&
        incoming().status in ['pending', 'approved', 'rejected'] &&
        incoming().userName is string && incoming().userName.size() >= 2 && incoming().userName.size() <= 120 &&
        incoming().targetScrubStudentId is string && incoming().targetScrubStudentId.size() > 0;
      allow update: if isValidId(requestId) &&
        incoming().status in ['pending', 'approved', 'rejected'];
      allow delete: if isValidId(requestId);
    }

    // 13. Saved Graduation Studio Designs (/saved_designs/{designId})
    match /saved_designs/{designId} {
      allow get, list: if true;
      allow create, update: if isValidId(designId) &&
        incoming().userId is string && incoming().userId.size() > 0 &&
        incoming().customName is string && incoming().customName.size() >= 2 && incoming().customName.size() <= 120 &&
        incoming().templateId is string && incoming().templateId.size() > 0;
      allow delete: if isValidId(designId);
    }

    // 14. Website Visitor Analytics Summary (/site_analytics/{docId})
    match /site_analytics/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId) &&
        incoming().totalVisits is number && incoming().totalVisits >= 0 &&
        incoming().uniqueVisitorsEstimate is number && incoming().uniqueVisitorsEstimate >= 0 &&
        incoming().lastUpdatedAt is string && incoming().lastUpdatedAt.size() >= 10;
      allow delete: if false;
    }

    // 15. Daily Website Visitor Analytics (/site_analytics_daily/{dateKey})
    match /site_analytics_daily/{dateKey} {
      allow get, list: if true;
      allow create, update: if isValidId(dateKey) &&
        incoming().dateKey is string && incoming().dateKey.size() == 10 &&
        incoming().visits is number && incoming().visits >= 0 &&
        incoming().uniqueVisitors is number && incoming().uniqueVisitors >= 0 &&
        incoming().updatedAt is string && incoming().updatedAt.size() >= 10;
      allow delete: if false;
    }

    // 16. SuperQi Payment Receipt Submissions Metadata (/payment_receipt_submissions/{submissionId})
    match /payment_receipt_submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isValidId(submissionId) &&
        incoming().studentId is string && incoming().studentId.size() > 0 &&
        incoming().studentName is string && incoming().studentName.size() >= 2 && incoming().studentName.size() <= 120 &&
        incoming().amountIQD is number && incoming().amountIQD > 0 && incoming().amountIQD <= 500000 &&
        incoming().vaultReceiptId is string && incoming().vaultReceiptId.size() > 0 &&
        incoming().status in ['pending_review', 'approved', 'rejected'];
      allow update: if isValidId(submissionId) &&
        incoming().status in ['pending_review', 'approved', 'rejected'];
      allow delete: if false;
    }

    // 17. Permission-Protected Private Receipt Image Vault (/private_receipt_vault/{vaultId})
    // Enumeration (list) is strictly forbidden so no one can scrape or list receipt images.
    match /private_receipt_vault/{vaultId} {
      allow get: if isValidId(vaultId);
      allow list: if false;
      allow create: if isValidId(vaultId) &&
        incoming().submissionId is string && incoming().submissionId.size() > 0 &&
        incoming().encryptedPayload is string && incoming().encryptedPayload.size() > 20 &&
        incoming().imageSha256 is string && incoming().imageSha256.size() >= 16;
      allow update, delete: if false;
    }

    // 18. Immutable Administrative Financial Settlements (/financial_settlements/{settlementId})
    match /financial_settlements/{settlementId} {
      allow get, list: if true;
      allow create: if isValidId(settlementId) &&
        incoming().studentId is string && incoming().studentId.size() > 0 &&
        incoming().reason is string && incoming().reason.size() >= 2 &&
        incoming().performedBy is string && incoming().performedBy.size() >= 2;
      allow update, delete: if false;
    }

    // 19. Private AI Trend Creations (/ai_trend_creations/{creationId})
    // Strict Privacy: Enumeration (list) is disabled so no user can ever browse another student's private creations.
    match /ai_trend_creations/{creationId} {
      allow get: if isValidId(creationId);
      allow list: if false;
      allow create, update: if isValidId(creationId) &&
        incoming().ownerUid is string && incoming().ownerUid.size() > 0 &&
        incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 160;
      allow delete: if isValidId(creationId);
    }

    // 20. Public Opt-In Shared AI Trend Gallery (/ai_trend_shared_gallery/{itemId})
    match /ai_trend_shared_gallery/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId) &&
        incoming().ownerUid is string && incoming().ownerUid.size() > 0 &&
        incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 160;
      allow delete: if isValidId(itemId);
    }

    // 21. Site Manager Custom AI Trend Ideas & Categories (/ai_trend_custom_ideas/{ideaId})
    match /ai_trend_custom_ideas/{ideaId} {
      allow get, list: if true;
      allow create, update: if isValidId(ideaId) &&
        incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 160 &&
        incoming().promptTemplate is string && incoming().promptTemplate.size() >= 5;
      allow delete: if isValidId(ideaId);
    }

    // 22. Aggregate AI Trend Studio Usage Stats (/ai_trend_stats/{docId})
    match /ai_trend_stats/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId) &&
        incoming().totalCreations is number && incoming().totalCreations >= 0;
      allow delete: if false;
    }
  }
}

