rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Admins & Role Permissions collection (/admins/{adminId})
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update: if isValidId(adminId) &&
        incoming().role in ['super_admin', 'finance_manager', 'event_manager', 'gallery_moderator', 'notification_manager', 'admin', 'moderator'];
      allow delete: if isValidId(adminId);
    }

    // 1c. Student Moderator Requests collection (/moderator_requests/{requestId})
    match /moderator_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId) &&
        incoming().status in ['pending', 'accepted', 'rejected'] &&
        incoming().userName is string && incoming().userName.size() >= 2 && incoming().userName.size() <= 100;
      allow update: if isValidId(requestId) &&
        incoming().status in ['pending', 'accepted', 'rejected'];
      allow delete: if isValidId(requestId);
    }

    // 1b. Logged-in User Accounts collection (/user_accounts/{userId})
    match /user_accounts/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) &&
        incoming().displayName is string;
      allow delete: if isValidId(userId);
    }

    // 2. Scrub Party Students Collection (/scrub_students/{studentId})
    match /scrub_students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId) &&
        incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 120 &&
        incoming().totalFeeIQD is number && incoming().totalFeeIQD >= 0 &&
        incoming().verifiedPaidIQD is number && incoming().verifiedPaidIQD >= 0 &&
        incoming().remainingBalanceIQD is number && incoming().remainingBalanceIQD >= 0;
      allow delete: if isValidId(studentId);
    }

    // 3. Scrub Party Student Payments (/student_payments/{paymentId})
    match /student_payments/{paymentId} {
      allow get, list: if true;
      allow create, update: if isValidId(paymentId) &&
        incoming().studentId is string && incoming().studentId.size() > 0 &&
        incoming().amountIQD is number && incoming().amountIQD >= 0 && incoming().amountIQD <= 500000;
      allow delete: if isValidId(paymentId);
    }

    // 4. Immutable Administrative & Financial Audit Logs (/audit_logs/{logId})
    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) &&
        incoming().action is string && incoming().action.size() > 0;
      allow update, delete: if false;
    }

    // 5. Student Registration Requests (/registration_requests/{requestId})
    match /registration_requests/{requestId} {
      allow get, list: if true;
      allow create, update: if isValidId(requestId) &&
        incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 100;
      allow delete: if isValidId(requestId);
    }

    // 6. Approved Graduates collection (/graduates/{graduateId})
    match /graduates/{graduateId} {
      allow get, list: if true;
      allow create, update: if isValidId(graduateId) &&
        incoming().fullName is string;
      allow delete: if isValidId(graduateId);
    }

    // 7. General Payment Transactions & Ledgers (/payments/{paymentId})
    match /payments/{paymentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(paymentId);
    }

    // 8. Private Media Locker (/private_media/{mediaId})
    match /private_media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(mediaId);
    }

    // 9. Platform & Countdown Configuration Settings (/settings/{docId})
    match /settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId);
    }

    // 10. Smart Graduation Music Library Metadata (/graduation_songs/{songId})
    match /graduation_songs/{songId} {
      allow get, list: if true;
      allow create, update: if isValidId(songId) &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 200 &&
        incoming().artist is string && incoming().artist.size() >= 1 && incoming().artist.size() <= 150 &&
        incoming().category in ['graduation', 'party', 'calm', 'energetic', 'nasheed'] &&
        incoming().audioUrl is string && incoming().audioUrl.size() >= 1 && incoming().audioUrl.size() <= 2000;
      allow delete: if isValidId(songId);

      // Subcollection for chunked audio storage
      match /audio_chunks/{chunkId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(chunkId);
      }
    }

    // 11. Unified Notifications Collection (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if isValidId(notificationId) &&
        incoming().title is string && incoming().message is string;
      allow delete: if isValidId(notificationId);
    }
  }
}
